# =========================================================================
# TEMPLATE KONFIGURASI LINGKUNGAN (ENVIRONMENT VARIABLES)
# =========================================================================
# Salin berkas ini menjadi '.env.local' untuk penyesuaian konfigurasi lokal
# atau konfigurasi server produksi.
#
# PENTING: Jangan masukkan berkas '.env.local' asli ke dalam repositori Git!
# =========================================================================

# 🔐 Kunci Pengaman Token JWT (Wajib diubah di Server Produksi)
# Digunakan untuk menandatangani (sign) sesi autentikasi pengguna.
# Anda dapat membuat kunci acak yang kuat menggunakan perintah: openssl rand -base64 32
JWT_SECRET=isi_dengan_kunci_acak_dan_panjang_untuk_produksi
